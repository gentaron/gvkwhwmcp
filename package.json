{
  "name": "gvkwhwmcp",
  "version": "0.2.0",
  "description": "Genesis Vault の記事から抜き出した、自動化と検証のノウハウを返す読み取り専用 MCP サーバ",
  "type": "module",
  "bin": {
    "gvkwhwmcp": "src/server.js"
  },
  "files": [
    "src/",
    "cards/",
    "LICENSE-CARDS.md"
  ],
  "scripts": {
    "start": "node src/bin.js",
    "validate": "node scripts/validate.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=95 test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "(MIT AND CC-BY-4.0)",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentaron/gvkwhwmcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "verification",
    "automation",
    "knowhow"
  ]
}
